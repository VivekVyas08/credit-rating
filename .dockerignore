# The 5+ GB weights are never baked into the image - they are mounted or auto-downloaded at runtime.
models/
.git/
**/__pycache__/
**/*.pyc
*.part
.venv/
# Local-only files: never baked into an image someone might push or share. (.claude/ itself is
# project content - skills the offline engines read - so only its per-machine settings stay out.)
.claude/settings.local.json
.env*
**/*.log
webapp/ui_prefs.json
node_modules/
_public/
*.bak
