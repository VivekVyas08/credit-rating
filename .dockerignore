# The 5+ GB weights are never baked into the image - they are mounted or auto-downloaded at runtime.
models/
.git/
**/__pycache__/
**/*.pyc
*.part
.venv/
# Local-only files: never baked into an image someone might push or share.
.claude/
.env*
**/*.log
webapp/ui_prefs.json
node_modules/
_public/
*.bak
